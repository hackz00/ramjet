{
	"name": "@ramjet/bootstrap",
	"version": "0.0.5",
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"main": "./dist/bootstrap-server.js",
	"types": "./dist/types/typesEntry.d.ts",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build": "cd ../.. && rspack build --mode production --configName ramjet-bootstrap",
		"prepack": "pnpm build",
		"prepublishOnly": "npx only-allow pnpm",
		"pub": "pnpm publish --no-git-checks --access public"
	},
	"dependencies": {
		"@mercuryworkshop/wisp-js": "catalog:",
		"tar": "^7.5.22"
	},
	"devDependencies": {
		"@mercuryworkshop/epoxy-transport": "catalog:",
		"@mercuryworkshop/libcurl-transport": "catalog:",
		"@mercuryworkshop/proxy-transports": "catalog:",
		"@ramjet/controller": "workspace:*",
		"@types/node": "^22.20.5"
	},
	"files": [
		"dist",
		"!dist/temp-types-build"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hackz00/ramjet.git",
		"directory": "packages/bootstrap"
	},
	"homepage": "https://github.com/hackz00/ramjet#readme",
	"bugs": {
		"url": "https://github.com/hackz00/ramjet/issues"
	}
