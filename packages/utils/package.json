{
	"name": "@ramjet/utils",
	"version": "0.0.3",
	"description": "Utilities for Ramjet proxy integrations",
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"license": "AGPL-3.0-only",
	"types": "./dist/types/typesEntry.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/typesEntry.d.ts",
			"import": "./dist/ramjet-utils.mjs",
			"default": "./dist/ramjet-utils.js"
		}
	},
	"files": [
		"dist",
		"!dist/temp-types-build"
	],
	"scripts": {
		"build": "cd ../.. && rspack build --mode production",
		"prepack": "pnpm run build",
		"prepublishOnly": "npx only-allow pnpm",
		"pub": "pnpm publish --no-git-checks --access public"
	},
	"peerDependencies": {
		"@ramjet/core": "*",
		"@ramjet/controller": "*"
	},
	"devDependencies": {
		"@ramjet/core": "workspace:*",
		"@ramjet/controller": "workspace:*",
		"@types/serviceworker": "^0.0.197"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hackz00/ramjet.git",
		"directory": "packages/utils"
	},
	"homepage": "https://github.com/hackz00/ramjet#readme",
	"bugs": {
		"url": "https://github.com/hackz00/ramjet/issues"
	}
}
