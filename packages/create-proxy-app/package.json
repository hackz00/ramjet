{
	"name": "create-ramjet-app",
	"version": "0.0.4",
	"description": "Scaffold a Ramjet or Ultraviolet proxy app",
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"license": "AGPL-3.0-only",
	"bin": {
		"create-ramjet-app": "./dist/index.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "cd ../.. && rspack build --mode production --configName create-ramjet-app",
		"prepack": "pnpm run build",
		"prepublishOnly": "npx only-allow pnpm",
		"pub": "pnpm publish --no-git-checks --access public"
	},
	"devDependencies": {
		"@types/node": "^26.6.4"
	},
	"dependencies": {
		"@clack/core": "^0.3.5",
		"@clack/prompts": "^0.7.0",
		"ajv": "^8.20.0",
		"chalk": "^5.6.2",
		"commander": "^12.1.0",
		"execa": "^9.6.1",
		"fs-extra": "^11.4.1",
		"sort-package-json": "^2.15.1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hackz00/ramjet.git",
		"directory": "packages/create-proxy-app"
	},
	"homepage": "https://github.com/hackz00/ramjet#readme",
	"bugs": {
		"url": "https://github.com/hackz00/ramjet/issues"
	}
}
